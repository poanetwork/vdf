# Cargo (workspace build artifacts live under the repo-root target/)
/target/

# rustfmt backups
**/*.rs.bk

# MSVC debug symbols (Windows)
*.pdb

# Environment / secrets (local tooling)
.env
.env.*

# OS
.DS_Store

# JetBrains
.idea/
*.iml

# Emacs
.#*
\#*#
*~

# Vim / Neovim
.*.sw[a-p]
*.sw[a-p]

# Legacy RLS logs (rust-analyzer does not emit these by default)
rls*.log
